<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- <xacro:macro name="trunk_ethercat_ros2_control" params="slave_config_path"> -->
  <xacro:macro name="trunk_ethercat_ros2_control" params="slave_config_path reversed_slave_config_path">
    <ros2_control name="eyou_trunk_system" type="system">
      <hardware>
        <plugin>ethercat_driver/EthercatDriver</plugin>
        <param name="master_id">0</param>
        <param name="control_frequency">100</param>
      </hardware>
      <joint name="trunk_joint1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <ec_module name="eyou_drive_1">
          <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
          <param name="alias">0</param>
          <param name="position">3</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">${slave_config_path}</param>
        </ec_module>
      </joint>
      <joint name="trunk_joint2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <ec_module name="eyou_drive_2">
          <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
          <param name="alias">0</param>
          <param name="position">2</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">${slave_config_path}</param>
        </ec_module>
      </joint>
      <joint name="trunk_joint3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <ec_module name="eyou_drive_3">
          <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
          <param name="alias">0</param>
          <param name="position">1</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">${reversed_slave_config_path}</param>
        </ec_module>
      </joint>
      <joint name="trunk_joint4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <ec_module name="eyou_drive_4">
          <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
          <param name="alias">0</param>
          <param name="position">0</param>
          <param name="mode_of_operation">8</param>
          <param name="slave_config">${reversed_slave_config_path}</param>
        </ec_module>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
